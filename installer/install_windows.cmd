@echo off
setlocal
powershell -NoProfile -ExecutionPolicy Bypass -Command "$srcDir = '%~dp0'; $target = Join-Path $env:LOCALAPPDATA 'SSJ_VPN'; $extSrc = Join-Path $srcDir 'SSJ_VPN'; if (-not (Test-Path (Join-Path $extSrc 'manifest.json'))) { if (Test-Path (Join-Path $srcDir 'manifest.json')) { $extSrc = $srcDir } else { $zips = @(); foreach ($d in @((Join-Path $env:USERPROFILE 'Downloads'), [Environment]::GetFolderPath('Desktop'))) { if (Test-Path $d) { $zips += Get-ChildItem -Path $d -Filter '*SSJ*VPN*.zip' -File -ErrorAction SilentlyContinue } }; $latest = $zips | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if ($latest) { $tmp = Join-Path $env:TEMP ('ssj_unpack_' + [guid]::NewGuid().ToString('N')); Expand-Archive -LiteralPath $latest.FullName -DestinationPath $tmp -Force; if (Test-Path (Join-Path $tmp 'SSJ_VPN\manifest.json')) { $extSrc = Join-Path $tmp 'SSJ_VPN'; $srcDir = $tmp } elseif (Test-Path (Join-Path $tmp 'manifest.json')) { $extSrc = $tmp; $srcDir = $tmp } } } }; if (-not (Test-Path (Join-Path $extSrc 'manifest.json'))) { Write-Host 'Unpack the ZIP archive first, then run this file again.' -ForegroundColor Red; pause; exit 1 }; New-Item -ItemType Directory -Force -Path $target | Out-Null; Copy-Item -Path (Join-Path $extSrc '*') -Destination $target -Recurse -Force; Set-Clipboard -Value $target; $guide = Join-Path $target 'installer\guide.html'; if (-not (Test-Path $guide)) { $guide = Join-Path $srcDir 'Инструкция.html' }; if (Test-Path $guide) { Start-Process $guide }; Write-Host ''; Write-Host '  [OK] SSJ VPN copied to:' -ForegroundColor Green; Write-Host ('       ' + $target) -ForegroundColor Cyan; Write-Host '  [OK] Folder path copied to clipboard (Ctrl+V)!' -ForegroundColor Green; Write-Host ''; Start-Sleep -Seconds 3"
